# VNDP environment — committed template. Copy to .env (gitignored) and fill real values.
# Keys per 04_REPOSITORY_STRUCTURE §4 / 08_INFRASTRUCTURE_SETUP §9. NO SECRETS IN THIS FILE.

VNDP_ENV=local

# --- PostgreSQL (system of record) ---
VNDP_DB_URL=postgresql+asyncpg://vndp:changeme_local@localhost:5432/vndp
VNDP_DB_PASSWORD=changeme_local

# --- Neo4j (knowledge graph) ---
VNDP_NEO4J_URI=bolt://localhost:7687
VNDP_NEO4J_USER=neo4j
VNDP_NEO4J_PASSWORD=changeme_local

# --- Qdrant (vectors) ---
VNDP_QDRANT_URL=http://localhost:6333
VNDP_QDRANT_API_KEY=

# --- n8n (ingestion) ---
VNDP_N8N_URL=http://localhost:5678/api/v1
VNDP_N8N_API_KEY=

# --- Event bus (Redpanda / Kafka) ---
VNDP_EVENT_BUS_URL=localhost:9092
VNDP_EVENT_BUS_SCHEMA_REGISTRY=http://localhost:18081

# --- LLM + embeddings (open-source, local-first via Ollama OpenAI-compatible endpoint) ---
# See docs/adr/ADR-0002 for model selection. Override model names freely.
VNDP_LLM_BASE_URL=http://localhost:11434/v1
VNDP_LLM_API_KEY=ollama
VNDP_LLM_MODEL=qwen2.5:14b-instruct
VNDP_EMBED_BASE_URL=http://localhost:11434/v1
VNDP_EMBED_MODEL=nomic-embed-text
